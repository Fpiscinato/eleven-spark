{
  "name": "eleven-spark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "icons": "node scripts/generate-icons.mjs",
    "version:bump": "tsx scripts/bump-version.ts",
    "audit:safety": "tsx scripts/audit-safety.ts",
    "audit:maths": "tsx scripts/audit-maths.ts",
    "audit:content": "tsx scripts/audit-content.ts 3",
    "audit:fsce": "tsx scripts/audit-fsce.ts",
    "audit:visibility": "tsx scripts/audit-visibility.ts",
    "audit": "npm run audit:safety && npm run audit:maths && npm run audit:content && npm run audit:fsce && npm run audit:visibility"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.151.3"
